#!/usr/bin/env bash

set -euo pipefail

self_name=${0##*/}

usage="Print or increment the project version.

Usage:
    $self_name [OPTIONS]

Options:
    -h    show this help message and exit

    -M    increment the major version
    -m    increment the minor version
    -p    increment the patch version

All increment options are mutually exclusive and the last specified wins.
If no increment option is given, the current version will be printed to stdout.
"

unset bump

while getopts "Mmph" opt; do
    case $opt in
        M) bump='major' ;;
        m) bump='minor' ;;
        p) bump='patch' ;;
        h)
            printf "%s\n" "$usage"
            exit
            ;;
        *) exit 64 ;;
    esac
done
shift $((OPTIND - 1))

read -r name version < <(uv version)

if [[ ! -v bump ]]; then
    printf "%s\n" "$version"
    exit
fi

uv version --bump "$bump"
version=$(uv version --short)

package_file=./src/$name/__init__.py
sed -i "/^__version__\b/s/=.*/= \"$version\"/" "$package_file"

git add "$package_file" uv.lock pyproject.toml

git commit -e \
    -m "build(release): bump version to $version" \
    -m "This is a $bump version change."

git tag -a -m "Release version $version" v"$version"
